{
	"info": {
		"_postman_id": "student-management-api",
		"name": "Student Management API",
		"description": "Complete API collection for Student Management System with Cookie-based Authentication, Student Management, and Class Management",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Signup (Student)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Student@123\",\n  \"name\": \"John Doe\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/signup",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"signup"
							]
						},
						"description": "Register a new user with default STUDENT role (cookies are automatically set)"
					}
				},
				{
					"name": "Login as Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@school.com\",\n  \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login with admin credentials (cookies are automatically set)"
					}
				},
				{
					"name": "Login as Teacher",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"teacher@school.com\",\n  \"password\": \"Teacher@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login with teacher credentials (cookies are automatically set)"
					}
				},
				{
					"name": "Get My Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						},
						"description": "Get current user profile (uses cookies for authentication)"
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/refresh-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"refresh-token"
							]
						},
						"description": "Refresh access token using refresh token from cookies"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"description": "Logout user and clear cookies"
					}
				}
			]
		},
		{
			"name": "Student Management",
			"item": [
				{
					"name": "Create Student (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newstudent@example.com\",\n  \"password\": \"Student@123\",\n  \"name\": \"Jane Smith\",\n  \"age\": 20\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/students",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"students"
							]
						},
						"description": "Create a new student (Admin access required, uses cookies for auth)"
					}
				},
				{
					"name": "Get All Students",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/students?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"students"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "sortBy",
									"value": "id"
								},
								{
									"key": "sortOrder",
									"value": "desc"
								}
							]
						},
						"description": "Get all students with pagination (Admin/Teacher access, uses cookies)"
					}
				},
				{
					"name": "Search Students",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/students?searchTerm=john&page=1&limit=5",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"students"
							],
							"query": [
								{
									"key": "searchTerm",
									"value": "john"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "5"
								}
							]
						},
						"description": "Search students by name (uses cookies for auth)"
					}
				},
				{
					"name": "Get Student by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/students/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"students",
								"1"
							]
						},
						"description": "Get student details by ID (Admin/Teacher/Own Student access, uses cookies)"
					}
				}
			]
		},
		{
			"name": "Class Management",
			"item": [
				{
					"name": "Create Class (Admin Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.id) {",
									"        pm.environment.set('classId', response.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Mathematics\",\n  \"section\": \"A\",\n  \"teacherId\": \"{{teacherId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/classes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"classes"
							]
						},
						"description": "Create a new class (Admin access required, uses cookies). Note: You need to get teacherId from teacher login response or database."
					}
				},
				{
					"name": "Enroll Student in Class",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"studentId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/classes/{{classId}}/enroll",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"classes",
								"{{classId}}",
								"enroll"
							]
						},
						"description": "Enroll a student in a class (Admin/Teacher access, uses cookies)"
					}
				},
				{
					"name": "Get Class Students",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/classes/{{classId}}/students?page=1&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"classes",
								"{{classId}}",
								"students"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Get all students in a specific class (Admin/Teacher access, uses cookies)"
					}
				},
				{
					"name": "Search Class Students",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/classes/{{classId}}/students?searchTerm=john&page=1&limit=5",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"classes",
								"{{classId}}",
								"students"
							],
							"query": [
								{
									"key": "searchTerm",
									"value": "john"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "5"
								}
							]
						},
						"description": "Search students within a specific class (uses cookies for auth)"
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api/v1",
			"type": "string"
		}
	]
}