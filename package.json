{
  "name": "travel-buddy-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "prisma": {
    "schema": "./prisma/schema"
  },
  "scripts": {
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "start": "bun run src/server.ts",
    "eslint": "bunx eslint . ./src",
    "prisma:format": "bunx prisma format"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^9.39.2",
    "prisma": "^6.16.3",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.54.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  }
}